<Window x:Name="WindowStartGame" x:Class="Game_Battleship.StartGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Game_Battleship"
        mc:Ignorable="d"
        Title="Start Game" Height="450" Width="800" Background="#FF0D8CAD">
    <Grid>
        <Button x:Name="btnHumanPlayer" Content="Human Player" HorizontalAlignment="Left" Margin="63,66,0,0" VerticalAlignment="Top" Width="91" Click="btnHumanPlayer_Click"/>
        <Button x:Name="btnCPUPlayer" Content="CPU Player" HorizontalAlignment="Left" Margin="211,66,0,0" VerticalAlignment="Top" Width="91" Click="btnCPUPlayer_Click"/>
        <ListBox x:Name="lbxDifficulty" Margin="175,115,509,238" HorizontalContentAlignment="Center" Visibility="Collapsed">
            <ListBoxItem Content="Easy"/>
            <ListBoxItem Content="Medium"/>
            <ListBoxItem Content="Hard"/>
        </ListBox>
        <TextBox x:Name="txtPlayerName" HorizontalAlignment="Left" Margin="171,134,0,0" TextWrapping="Wrap" Text="Player 1" VerticalAlignment="Top" Width="120" Visibility="Collapsed"/>
        <Label x:Name="lblPlayerName" Content="Player Name:" HorizontalAlignment="Left" Margin="86,130,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.438,-0.61" Visibility="Collapsed"/>
        <Button x:Name="btnPlaceShips" Content="Place Ships" HorizontalAlignment="Center" Margin="0,258,0,0" VerticalAlignment="Top" Width="100" Click="btnPlaceShips_Click" Visibility="Collapsed"/>
        <Label x:Name="lblDifficulty" Content="CPU Difficulty:" HorizontalAlignment="Left" Margin="78,135,0,0" VerticalAlignment="Top" Visibility="Collapsed"/>
        <Label x:Name="lblPlayer1" Content="Player 1" HorizontalAlignment="Left" Margin="152,22,0,0" VerticalAlignment="Top" Width="84" FontSize="16"/>
        <Button x:Name="btnHumanPlayer2" Content="Human Player" HorizontalAlignment="Left" Margin="470,67,0,0" VerticalAlignment="Top" Width="91" Click="btnHumanPlayer2_Click"/>
        <Button x:Name="btnCPUPlayer2" Content="CPU Player" HorizontalAlignment="Left" Margin="607,66,0,0" VerticalAlignment="Top" Width="91" Click="btnCPUPlayer2_Click"/>
        <ListBox x:Name="lbxDifficulty2" Margin="557,115,127,238" HorizontalContentAlignment="Center" Visibility="Collapsed">
            <ListBoxItem Content="Easy"/>
            <ListBoxItem Content="Medium"/>
            <ListBoxItem Content="Hard"/>
        </ListBox>
        <TextBox x:Name="txtPlayerName2" HorizontalAlignment="Left" Margin="551,134,0,0" TextWrapping="Wrap" Text="Player 2" VerticalAlignment="Top" Width="120" Visibility="Collapsed"/>
        <Label x:Name="lblPlayerName2" Content="Player Name:" HorizontalAlignment="Left" Margin="470,130,0,0" VerticalAlignment="Top" Visibility="Collapsed"/>
        <Label x:Name="lblDifficulty2" Content="CPU Difficulty:" HorizontalAlignment="Left" Margin="467,148,0,0" VerticalAlignment="Top" Visibility="Collapsed"/>
        <Label x:Name="lblPlayer2" Content="Player 2" HorizontalAlignment="Left" Margin="551,31,0,0" VerticalAlignment="Top" Width="84" FontSize="16"/>
        <Button x:Name="btnStartCPUGame" Content="Start Game" HorizontalAlignment="Center" Margin="0,294,0,0" VerticalAlignment="Top" Width="100" Click="btnPlaceShips_Click" Visibility="Collapsed"/>

    </Grid>
</Window>
