<Window x:Class="Game_Battleship.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Game_Battleship"
        mc:Ignorable="d"
        Title="Battleship Rules" Height="379" Width="540" Background="#FF48A076">
    <Grid>
        <TextBlock x:Name="txblAbout" HorizontalAlignment="Left" Margin="35,30,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="58" Width="433"><Run Text="Battleship is a 2 player strategy type game where an attempt is made to sink all your opponent's ship. Play time can take up to an hour and the recommended"/><Run Text=" age for players is 8+."/></TextBlock>
        <TextBlock x:Name="txblRules" HorizontalAlignment="Left" Margin="35,106,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="190" Width="433"><Run Text="Rules: "/><LineBreak/><Run Text="Each player takes turn placing their 5 ships on their ocean grid, no overlapping of ships and they must be vertical or horizontal. Once both players place their ships, then the players take turn selecting one coordinate on the attack grid. If the coordinate chosen hits one of the opponent's ship then they must indicate a hit as well as the name of the ship that was hit."/><LineBreak/><Run/><LineBreak/><Run Text="NO PEEKING! Do not look at the game while your opponent is taking their turn. "/><LineBreak/><Run/><LineBreak/><Run Text="The first player to sink all five of their opponent's ships is the winner."/></TextBlock>
        <Button x:Name="btnCloseRules" Content="Close" HorizontalAlignment="Center" Margin="0,0,0,10" VerticalAlignment="Bottom" Width="68" Click="btnCloseRules_Click"/>
    </Grid>
</Window>
