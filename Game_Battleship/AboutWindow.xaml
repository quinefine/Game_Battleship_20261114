<Window x:Class="Game_Battleship.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Game_Battleship"
        mc:Ignorable="d"
        Title="About Game" Height="379" Width="540" Background="#FF48A076">
    <Grid>
        <Button x:Name="btnCloseAbout" Content="Close" HorizontalAlignment="Center" Margin="0,0,0,10" VerticalAlignment="Bottom" Click="btnCloseAbout_Click" Width="68"/>
        <TextBlock x:Name="txblDevelopers" HorizontalAlignment="Left" Margin="35,30,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="86" Width="433"><Run Text="Developers: "/><LineBreak/><Run/><LineBreak/><Run Text="Michael Richmond"/><LineBreak/><Run Text="Natalie Borges Blondet"/><LineBreak/><Run Text="Landon Heezen"/></TextBlock>
        <TextBlock x:Name="txblVersion" HorizontalAlignment="Left" Margin="35,121,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="74" Width="433"><Run Text="Version:"/><LineBreak/><Run/><LineBreak/><Run Text="Battleship 1.0"/></TextBlock>
        <TextBlock x:Name="txblDate" HorizontalAlignment="Left" Margin="35,200,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="74" Width="433"><Run Text="Date:"/><LineBreak/><Run/><LineBreak/><Run Text="11/10/2026"/></TextBlock>

    </Grid>
</Window>
