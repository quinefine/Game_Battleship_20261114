<Window x:Name="frmMain" x:Class="Game_Battleship.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Game_Battleship"
        mc:Ignorable="d"
        Title="Main Menu" Height="523" Width="756" Background="#FF2D3B75">
    <Grid x:Name="MyGrid">
        <Button x:Name="btnStartGame" Content="Start Game" HorizontalAlignment="Left" Margin="271,236,0,0" VerticalAlignment="Top" Height="95" Width="208" FontSize="24" Click="btnStartGame_Click"/>
        <Button x:Name="btnRules" Content="Rules" HorizontalAlignment="Left" Margin="171,376,0,0" VerticalAlignment="Top" Height="43" Width="96" Click="btnRules_Click"/>
        <Button x:Name="btnClose" Content="Close" HorizontalAlignment="Left" Margin="605,376,0,0" VerticalAlignment="Top" Height="43" Width="97" Click="btnClose_Click"/>
        <Label x:Name="lblBattleship" Content="BATTLESHIP" HorizontalAlignment="Center" Height="103" Margin="0,77,0,0" VerticalAlignment="Top" Width="400" FontSize="60" FontWeight="Heavy" HorizontalContentAlignment="Center"/>
        <Button x:Name="btnAbout" Content="About" HorizontalAlignment="Left" Margin="52,376,0,0" VerticalAlignment="Top" Height="43" Width="96" Click="btnAbout_Click"/>
        <Button x:Name="btnScoreboard" Content="Scoreboard" HorizontalAlignment="Left" Margin="488,377,0,0" VerticalAlignment="Top" Height="42" Width="95" Click="btnScoreboard_Click"/>

    </Grid>
</Window>
