<Window x:Name="frmMain" x:Class="Game_Battleship.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Game_Battleship"
        mc:Ignorable="d"
        Title="Main Menu" Height="450" Width="800" Background="#FF1C647D">
    <Grid x:Name="MyGrid">
        <Button x:Name="btnStartGame" Content="Start Game" HorizontalAlignment="Center" Margin="0,261,0,0" VerticalAlignment="Top" Height="68" Width="186" FontSize="24" Click="btnStartGame_Click"/>
        <Button x:Name="btnRules" Content="Rules" HorizontalAlignment="Left" Margin="129,374,0,0" VerticalAlignment="Top" Height="43" Width="96" Click="btnRules_Click"/>
        <Button x:Name="btnClose" Content="Close" HorizontalAlignment="Left" Margin="686,374,0,0" VerticalAlignment="Top" Height="43" Width="97" Click="btnClose_Click"/>
        <Label x:Name="lblBattleship" Content="BATTLESHIP" HorizontalAlignment="Center" Height="71" Margin="0,59,0,0" VerticalAlignment="Top" Width="382" FontSize="55" FontWeight="SemiBold" HorizontalContentAlignment="Center"/>
        <Button x:Name="btnAbout" Content="About" HorizontalAlignment="Left" Margin="10,374,0,0" VerticalAlignment="Top" Height="43" Width="96" Click="btnAbout_Click"/>

    </Grid>
</Window>
